# Salin ke .env.local. Gunakan project development, bukan production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Password role mamitika_auth diatur lewat dashboard/SQL operator, bukan di repository.
DATABASE_URL=
ADMIN_USER_ID=
OWNER_EMAIL=
OWNER_NAME=Pemilik Mamitika
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Must exactly match the development project URL before `npm run seed` can write.
SUPABASE_DEVELOPMENT_URL=
# Supabase secret key server-only; tidak pernah memakai prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
